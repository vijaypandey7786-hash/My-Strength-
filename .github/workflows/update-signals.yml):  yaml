name: Update Trading Signals

on:
  schedule:
    # Runs every 15 minutes, 9:00–15:30 IST (Mon–Fri)
    # IST = UTC+5:30, so 9:00 IST = 3:30 UTC, 15:30 IST = 10:00 UTC
    - cron: '*/15 3-10 * * 1-5'
  workflow_dispatch:  # lets you trigger it manually too

jobs:
  update-signals:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run signals script
        run: python signals_backend.py

      - name: Commit and push updated data
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add -A
          git diff --quiet && git diff --staged --quiet || git commit -m "Auto-update signals $(date -u +'%Y-%m-%d %H:%M UTC')"
          git push

